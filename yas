    public function isJournalist(): bool { return $this->role?->name === 'journalist'; }
}

3. Middleware

app/Http/Middleware/EnsureUserHasRole.php
php

<?php
namespace App\Http\Middleware;
use Closure;
use Illuminate\Http\Request;

class EnsureUserHasRole
{
    public function handle(Request $request, Closure $next, string ...$roles)
    {
        if (!$request->user() || !in_array($request->user()->role->name, $roles)) {
            abort(403, 'У вас нет прав для доступа к этой странице.');
        }
        return $next($request);
    }
}

Не забудьте зарегистрировать алиас в bootstrap/app.php:
