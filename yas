<?php
namespace App\Http\Controllers;
use App\Models\Role;
use App\Models\Text;
use App\Models\User;
use Illuminate\Http\Request;

class AdminController extends Controller
{
    public function index()
    {
        $texts = Text::with(['category', 'author'])->latest()->paginate(10);
        $users = User::with('role')->get();
        $roles = Role::all();
        return view('admin.index', compact('texts', 'users', 'roles'));
    }

    public function destroyText(Text $text)
    {
        $text->delete();
        return back()->with('success', 'Статья удалена.');
    }

    public function toggleBlock(Text $text)
    {
        $text->update(['is_blocked' => !$text->is_blocked]);
        return back()->with('success', 'Статус статьи изменён.');
    }

    public function updateRole(Request $request, User $user)
    {
        $data = $request->validate(['role_id' => ['required', 'exists:roles,id']]);
        $user->update(['role_id' => $data['role_id']]);
        return back()->with('success', 'Роль пользователя обновлена.');
    }
}

